{
  "name": "@dsh-runtime/harness-plugin",
  "version": "0.1.0-rc.20",
  "private": true,
  "type": "module",
  "description": "In-progress standalone DeepSeekHarness host adapter for DSH Runtime",
  "engines": { "node": ">=24.19.0" },
  "main": "./lib/index.js",
  "bin": { "dsh-runtime-migrate-home": "./scripts/migrate-legacy-home.mjs" },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/migrate-legacy-home.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ./scripts/clean-lib.mjs && tsc -p tsconfig.build.json && node ./scripts/build-client.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test:admission": "tsc -p tsconfig.test.json && node .build/test/admission.test.js",
    "test:worker": "tsc -p tsconfig.test.json && node .build/test/worker.test.js",
    "test:pin-store": "tsc -p tsconfig.test.json && node .build/test/pin-store.test.js",
    "test:provider": "tsc -p tsconfig.test.json && node .build/test/provider.test.js",
    "test:launcher": "tsc -p tsconfig.test.json && node .build/test/runtime-launcher.test.js",
    "test:host-core": "tsc -p tsconfig.test.json && node .build/test/host-core.test.js",
    "test:tool": "tsc -p tsconfig.test.json && node .build/test/tool.test.js",
    "test:entry": "tsc -p tsconfig.test.json && node .build/test/entry.test.js",
    "test:api-agent-trace": "tsc -p tsconfig.test.json && node .build/test/api-agent-trace.test.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "6.0.3"
  }
}
